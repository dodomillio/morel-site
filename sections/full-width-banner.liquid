<section class="full-width-row">
  <a class="banner banner--full" href="{{ section.settings.url }}">
    {%- if section.settings.image -%}
      <img class="banner__image" src="{{ section.settings.image | image_url: width: 2400 }}" width="1200" alt="" loading="lazy">
    {%- else -%}
      <span class="placeholder-img placeholder-img--wide"><span>Photo boutique</span></span>
    {%- endif -%}
    <span class="banner__store-info">
      <span class="banner__title">{{ section.settings.heading }}</span>
      {%- if section.settings.description != blank -%}<span class="banner__address">{{ section.settings.description }}</span>{%- endif -%}
    </span>
  </a>
</section>

{% schema %}
{
  "name": "Bannière pleine largeur",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Notre boutique" },
    { "type": "text", "id": "description", "label": "Description", "default": "10 place de l'Exemple, 75000 Paris" },
    { "type": "url", "id": "url", "label": "Lien" }
  ],
  "presets": [{ "name": "Bannière pleine largeur" }]
}
{% endschema %}
