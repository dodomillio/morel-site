{%- liquid
  assign cab_h = 'cabas,cabas-riviera,le-solen,le-nomad'
  assign poch_h = 'nos-pochettes,la-milo,pochette-capri,les-syenna,pochette-syenna-1,pochette-capri-1'
  assign cab_list = cab_h | split: ','
  assign poch_list = poch_h | split: ','
  assign pills = ''
  assign pill_all = ''
  if cab_list contains collection.handle
    assign pills = 'cabas-riviera:Riviera,le-solen:Solen,le-nomad:Nomad' | split: ','
    assign pill_all = 'cabas'
    assign pill_all_label = 'Tous les cabas'
  elsif poch_list contains collection.handle
    assign pills = 'la-milo:Milo,pochette-capri:Capri,les-syenna:Syenna' | split: ','
    assign pill_all = 'nos-pochettes'
    assign pill_all_label = 'Toutes les pochettes'
  endif
-%}
<section class="collection-page cp">
  <div class="cp-head">
    <a class="cp-head__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }}"><span class="cp-head__brand-v">MORËL</span><span class="cp-head__brand-h">PARIS</span></a>
    <div class="cp-head__text">
      <h1 class="cp-head__title">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="collection-page__description cp-head__desc">
          <div class="collection-page__description-excerpt">{{ collection.description | strip_html | truncatewords: 40 }}</div>
          <div class="collection-page__description-full" hidden>{{ collection.description }}</div>
          <button class="collection-page__description-toggle cp-head__more" type="button" data-description-toggle>Plus</button>
        </div>
      {%- endif -%}
      <nav class="breadcrumbs cp-head__crumbs">
        <a class="breadcrumbs__link" href="{{ routes.root_url }}">Accueil</a>
        <span>&gt;</span>
        <span class="breadcrumbs__current-page">{{ collection.title }}</span>
      </nav>
    </div>
  </div>

  <div class="cp-bar">
    <div class="cp-bar__pills">
      {%- if pill_all != '' -%}
        <a class="cp-pill{% if collection.handle == pill_all %} is-active{% endif %}" href="/collections/{{ pill_all }}">{{ pill_all_label }}</a>
        {%- for p in pills -%}
          {%- assign pp = p | split: ':' -%}
          <a class="cp-pill{% if collection.handle == pp[0] %} is-active{% endif %}" href="/collections/{{ pp[0] }}">{{ pp[1] }}</a>
        {%- endfor -%}
      {%- elsif section.settings.related_collections.count > 0 -%}
        <a class="cp-pill is-active" href="{{ collection.url }}">{{ collection.title }}</a>
        {%- for related in section.settings.related_collections -%}
          <a class="cp-pill" href="{{ related.url }}">{{ related.title }}</a>
        {%- endfor -%}
      {%- endif -%}
    </div>
    <button class="cp-bar__filter collection-page__filter-toggle" type="button" data-filter-toggle>Filtrer et trier</button>
  </div>

  <form class="filter-and-sort" action="{{ collection.url }}" method="get" data-filter-form>
    <div class="filter-and-sort__group">
      <div class="filter-and-sort__heading">Trier par</div>
      <ul class="filter-and-sort__list">
        {%- for option in collection.sort_options -%}
          <li>
            <label class="filter-and-sort__label">
              <input class="filter-and-sort__input" type="radio" name="sort_by" value="{{ option.value }}" {% if option.value == collection.sort_by %}checked{% endif %}>
              <span>{{ option.name }}</span>
            </label>
          </li>
        {%- endfor -%}
      </ul>
    </div>

    {%- for filter in collection.filters -%}
      <div class="filter-and-sort__group">
        <div class="filter-and-sort__heading">{{ filter.label }}</div>
        <ul class="filter-and-sort__list">
          {%- for value in filter.values -%}
            <li>
              <label class="filter-and-sort__label">
                <input
                  class="filter-and-sort__input"
                  type="checkbox"
                  name="{{ value.param_name }}"
                  value="{{ value.value }}"
                  {% if value.active %}checked{% endif %}
                  {% if value.count == 0 and value.active == false %}disabled{% endif %}
                >
                <span>{{ value.label }} ({{ value.count }})</span>
              </label>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endfor -%}

    <div class="filter-and-sort__buttons">
      <a class="btn btn--bordered" href="{{ collection.url }}">Effacer les filtres</a>
      <button class="btn btn--primary" type="submit">Appliquer les filtres</button>
    </div>
  </form>

  {%- paginate collection.products by 48 -%}
    <div class="collection-page__grid cp-grid">
      {%- for product in collection.products -%}
        {%- if product.available -%}{% render 'product-card', product: product %}{%- endif -%}
      {%- endfor -%}
      {%- for product in collection.products -%}
        {%- unless product.available -%}{% render 'product-card', product: product %}{%- endunless -%}
      {%- endfor -%}
      {%- if collection.products.size == 0 -%}
        <p class="collection-page__empty">Aucun produit dans cette collection pour le moment.</p>
      {%- endif -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="collection-page__pagination">
        {%- if paginate.next -%}
          <a class="btn btn--primary collection-page__load-more" href="{{ paginate.next.url }}">Voir plus</a>
        {%- endif -%}
        <div class="collection-page__pagination-links">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&larr; Précédent</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span>{{ part.title }}</span>{%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Suivant &rarr;</a>{%- endif -%}
        </div>
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</section>


<style>
.cp{padding:0 !important;max-width:none !important;}
.cp-head{display:grid;grid-template-columns:1fr 1fr;gap:24px;padding:28px var(--gutter,20px) 28px;align-items:start;}
.cp-head__brand{display:flex;align-items:flex-start;gap:6px;color:#111;text-decoration:none;font-family:var(--font-heading);font-stretch:125%;font-weight:800;line-height:.9;}
.cp-head__brand-v{writing-mode:vertical-rl;transform:rotate(180deg);font-size:clamp(30px,2.8vw,42px);letter-spacing:.02em;}
.cp-head__brand-h{font-size:clamp(22px,2vw,30px);letter-spacing:.02em;}
.cp-head__text{max-width:520px;padding-top:6px;}
.cp-head__title{font-family:var(--font-heading);font-stretch:125%;font-weight:800;text-transform:uppercase;letter-spacing:var(--ls,0);font-size:clamp(30px,3vw,44px);line-height:1;margin:0 0 18px;text-align:left;}
.cp-head__desc{font-size:13px;line-height:1.45;margin:0 0 6px;text-align:left;}
.cp-head__more{background:none;border:0;padding:0;margin-top:4px;font-size:12px;text-transform:uppercase;text-decoration:underline;letter-spacing:var(--ls,0);cursor:pointer;color:#111;}
.cp-head__crumbs{margin-top:10px;font-size:12px;justify-content:flex-start;}
.cp-bar{display:flex;align-items:center;gap:12px;padding:0 var(--gutter,20px) 16px;}
.cp-bar__pills{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;flex:1;min-width:0;}
.cp-bar__pills::-webkit-scrollbar{display:none;}
.cp-pill{flex:none;padding:9px 14px;background:#f1eeea;color:#111;font-size:12px;text-transform:uppercase;letter-spacing:var(--ls,.4px);text-decoration:none;white-space:nowrap;transition:background .2s,color .2s;}
.cp-pill:hover{background:#e4dfd8;}
.cp-pill.is-active{background:#5b2a17;color:#fff;}
.cp-bar__filter{flex:none;margin-left:auto;padding:10px 16px;background:#5b2a17;color:#fff;border:0;font-size:12px;text-transform:uppercase;letter-spacing:var(--ls,.4px);cursor:pointer;}
.cp-grid{display:grid !important;grid-template-columns:repeat(4,minmax(0,1fr)) !important;gap:1px !important;background:#e6e1da;border-top:1px solid #e6e1da;border-bottom:1px solid #e6e1da;padding:0 !important;margin:0 !important;}
.cp-grid > .product-card{background:#fff;display:flex;flex-direction:column;position:relative;min-width:0;}
.cp-grid .product-card__image{width:100%;aspect-ratio:4/5;object-fit:cover;background:#f1eeea;display:block;margin:0;border-radius:0;}
.cp-grid .product-card__title{display:block;padding:12px 16px 0;font-size:13px;line-height:1.3;}
.cp-grid .product-card__price{display:block;padding:2px 16px 14px;font-size:13px;}
.cp-grid .product-card__badge,.cp-grid [class*="badge"]{background:#fff;color:#111;border-radius:0;font-size:11px;padding:6px 10px;}
@media (max-width:767px){
  .cp-head{grid-template-columns:1fr;padding:24px 16px 24px;}
  .cp-head__brand{display:none;}
  .cp-bar{padding:0 16px 12px;}
  .cp-bar__filter{padding:9px 12px;}
  .cp-grid{grid-template-columns:repeat(2,minmax(0,1fr)) !important;}
  .cp-grid .product-card__title{padding:10px 10px 0;font-size:12px;}
  .cp-grid .product-card__price{padding:2px 10px 12px;font-size:12px;}
}
</style>

{% schema %}
{
  "name": "Page collection",
  "settings": [
    { "type": "collection_list", "id": "related_collections", "label": "Collections associées", "limit": 12 }
  ]
}
{% endschema %}
