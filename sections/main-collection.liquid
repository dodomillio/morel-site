{%- liquid
  assign model_handles = 'cabas-riviera,le-solen,le-nomad,la-milo,pochette-capri,les-syenna' | split: ','
  assign total = collection.products_count
-%}
<section class="mc" data-mc>
  <div class="mc-bar">
    <form class="mc-bar__filters" action="{{ collection.url }}" method="get" data-mc-form>
      {%- if collection.sort_by != blank -%}<input type="hidden" name="sort_by" value="{{ collection.sort_by }}">{%- endif -%}
      {%- for filter in collection.filters -%}
        {%- assign flabel = filter.label -%}
        {%- if flabel == 'Availability' -%}{%- assign flabel = 'Disponibilité' -%}{%- elsif flabel == 'Price' -%}{%- assign flabel = 'Prix' -%}{%- endif -%}
        <details class="mc-dd">
          <summary class="mc-dd__btn">{{ flabel }}<svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.3"/></svg></summary>
          <div class="mc-dd__panel">
            {%- if filter.type == 'price_range' -%}
              <div class="mc-price">
                <label>De<input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | replace: ',', '.' }}" placeholder="0" min="0"></label>
                <label>À<input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '.' }}" placeholder="{{ filter.range_max | money_without_currency | replace: ',', '.' }}" min="0"></label>
              </div>
              <button class="mc-dd__apply" type="submit">Appliquer</button>
            {%- else -%}
              {%- for value in filter.values -%}
                {%- assign vlabel = value.label -%}
                {%- if vlabel == 'In stock' -%}{%- assign vlabel = 'En stock' -%}{%- elsif vlabel == 'Out of stock' -%}{%- assign vlabel = 'Épuisé' -%}{%- endif -%}
                <label class="mc-check"><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %} data-mc-auto><span>{{ vlabel }} ({{ value.count }})</span></label>
              {%- endfor -%}
            {%- endif -%}
          </div>
        </details>
      {%- endfor -%}
    </form>
    <div class="mc-bar__right">
      <span class="mc-count">{{ total }} article{% if total > 1 %}s{% endif %}</span>
      <details class="mc-dd mc-dd--right">
        <summary class="mc-dd__btn">Trier<svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.3"/></svg></summary>
        <div class="mc-dd__panel">
          {%- for option in collection.sort_options -%}
            <a class="mc-sort{% if option.value == collection.sort_by %} is-active{% endif %}" href="{{ collection.url }}?sort_by={{ option.value }}">{{ option.name }}</a>
          {%- endfor -%}
        </div>
      </details>
      <div class="mc-view" role="group" aria-label="Affichage">
        <button type="button" class="mc-view__btn is-active" data-mc-cols="3" aria-label="3 colonnes"><svg width="14" height="14" viewBox="0 0 14 14"><rect x="0" y="0" width="6" height="6"/><rect x="8" y="0" width="6" height="6"/><rect x="0" y="8" width="6" height="6"/><rect x="8" y="8" width="6" height="6"/></svg></button>
        <button type="button" class="mc-view__btn" data-mc-cols="4" aria-label="4 colonnes"><svg width="14" height="14" viewBox="0 0 14 14"><rect x="0" y="0" width="3.3" height="3.3"/><rect x="5.3" y="0" width="3.3" height="3.3"/><rect x="10.6" y="0" width="3.3" height="3.3"/><rect x="0" y="5.3" width="3.3" height="3.3"/><rect x="5.3" y="5.3" width="3.3" height="3.3"/><rect x="10.6" y="5.3" width="3.3" height="3.3"/><rect x="0" y="10.6" width="3.3" height="3.3"/><rect x="5.3" y="10.6" width="3.3" height="3.3"/><rect x="10.6" y="10.6" width="3.3" height="3.3"/></svg></button>
      </div>
    </div>
  </div>

  {%- paginate collection.products by 48 -%}
    <ul class="mc-grid" data-mc-grid>
      {%- for pass in (1..2) -%}
        {%- for product in collection.products -%}
          {%- if pass == 1 and product.available == false -%}{%- continue -%}{%- endif -%}
          {%- if pass == 2 and product.available -%}{%- continue -%}{%- endif -%}
          <li class="mc-card">
            <a class="mc-card__media" href="{{ product.url }}">
              {%- unless product.available -%}<span class="mc-card__badge">Épuisé</span>{%- endunless -%}
              {%- if product.featured_image -%}
                <img src="{{ product.featured_image | image_url: width: 900 }}" srcset="{{ product.featured_image | image_url: width: 500 }} 500w, {{ product.featured_image | image_url: width: 900 }} 900w" sizes="(max-width: 767px) 50vw, 33vw" alt="{{ product.title | escape }}" loading="lazy" width="900" height="{{ 900 | divided_by: product.featured_image.aspect_ratio | round }}">
              {%- endif -%}
            </a>
            <button class="mc-card__fav" type="button" aria-label="Ajouter aux favoris" aria-pressed="false" data-fav="{{ product.handle }}"><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-7.5-10.1A4.2 4.2 0 0 1 12 7.6a4.2 4.2 0 0 1 7.5 2.8c0 5.5-7.5 10.1-7.5 10.1z" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></button>
            <a class="mc-card__info" href="{{ product.url }}">
              <span class="mc-card__title">{{ product.title }}</span>
              <span class="mc-card__price">{{ product.price | money }}</span>
            </a>
            {%- assign model = nil -%}
            {%- for c in product.collections -%}{%- if model_handles contains c.handle -%}{%- assign model = c -%}{%- break -%}{%- endif -%}{%- endfor -%}
            {%- if model and model.products_count > 1 -%}
              <div class="mc-sw">
                {%- for sib in model.products limit: 12 -%}
                  {%- assign n = sib.title | downcase -%}
                  {%- capture col -%}{%- render 'mc-color', n: n -%}{%- endcapture -%}
                  {%- assign col = col | strip -%}
                  <a class="mc-sw__dot{% if sib.id == product.id %} is-current{% endif %}" href="{{ sib.url }}" title="{{ sib.title | escape }}" style="{% if col != blank %}background:{{ col }};{% elsif sib.featured_image %}background-image:url({{ sib.featured_image | image_url: width: 60 }});{% endif %}"></a>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      {%- endfor -%}
    </ul>
    {%- if collection.products.size == 0 -%}<p class="mc-empty">Aucun produit pour le moment.</p>{%- endif -%}
    {%- if paginate.pages > 1 -%}
      <nav class="mc-pages">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&larr;</a>{%- endif -%}
        {%- for part in paginate.parts -%}{%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span>{{ part.title }}</span>{%- endif -%}{%- endfor -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}">&rarr;</a>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</section>

<style>
.mc{padding:0 var(--gutter,20px) 56px;}
.mc-bar{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:22px 0 18px;font-size:12px;text-transform:uppercase;letter-spacing:var(--ls,.4px);}
.mc-bar__filters,.mc-bar__right{display:flex;align-items:center;gap:22px;}
.mc-dd{position:relative;}
.mc-dd__btn{list-style:none;cursor:pointer;display:flex;align-items:center;gap:6px;user-select:none;}
.mc-dd__btn::-webkit-details-marker{display:none;}
.mc-dd[open] .mc-dd__btn svg{transform:rotate(180deg);}
.mc-dd__panel{position:absolute;top:calc(100% + 10px);left:0;z-index:20;min-width:200px;background:#fff;border:1px solid #e6e1da;padding:14px 16px;display:flex;flex-direction:column;gap:10px;text-transform:none;letter-spacing:0;font-size:13px;box-shadow:0 8px 24px rgba(0,0,0,.06);}
.mc-dd--right .mc-dd__panel{left:auto;right:0;}
.mc-check{display:flex;gap:8px;align-items:center;cursor:pointer;}
.mc-price{display:flex;gap:10px;}
.mc-price label{display:flex;flex-direction:column;gap:4px;font-size:12px;}
.mc-price input{width:80px;padding:6px 8px;border:1px solid #d9d3cb;font:inherit;}
.mc-dd__apply{align-self:flex-start;padding:8px 14px;background:#111;color:#fff;border:0;font-size:12px;text-transform:uppercase;cursor:pointer;}
.mc-sort{color:#111;text-decoration:none;}
.mc-sort.is-active{text-decoration:underline;}
.mc-count{color:#6b6b6b;}
.mc-view{display:flex;gap:4px;}
.mc-view__btn{width:28px;height:28px;display:grid;place-items:center;border:0;background:transparent;cursor:pointer;fill:#b9b4ad;border-radius:4px;}
.mc-view__btn.is-active{background:#f1eeea;fill:#111;}
.mc-grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px 10px;}
.mc[data-cols="4"] .mc-grid{grid-template-columns:repeat(4,minmax(0,1fr));}
.mc-card{position:relative;min-width:0;}
.mc-card__media{display:block;position:relative;aspect-ratio:4/5;overflow:hidden;background:#f1eeea;}
.mc-card__media img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .6s ease;}
.mc-card__media:hover img{transform:scale(1.03);}
.mc-card__badge{position:absolute;top:10px;left:10px;z-index:2;background:#111;color:#fff;font-size:12px;text-transform:uppercase;padding:6px 9px;letter-spacing:var(--ls,.4px);}
.mc-card__fav{position:absolute;top:10px;right:10px;z-index:3;width:34px;height:34px;border-radius:50%;border:0;background:rgba(255,255,255,.9);display:grid;place-items:center;cursor:pointer;color:#111;}
.mc-card__fav[aria-pressed="true"] path{fill:#9a2a17;stroke:#9a2a17;}
.mc-card__info{display:block;padding-top:10px;color:#111;text-decoration:none;}
.mc-card__title{display:block;font-size:13px;text-transform:uppercase;letter-spacing:var(--ls,.4px);line-height:1.3;}
.mc-card__price{display:block;font-size:13px;margin-top:2px;}
.mc-sw{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px;}
.mc-sw__dot{width:14px;height:14px;border-radius:50%;background-size:cover;background-position:center;box-shadow:inset 0 0 0 1px rgba(0,0,0,.12);outline-offset:2px;}
.mc-sw__dot.is-current{outline:1px solid #111;}
.mc-empty{padding:40px 0;text-align:center;}
.mc-pages{display:flex;justify-content:center;gap:14px;padding-top:36px;font-size:13px;}
@media (max-width:767px){
  .mc{padding:0 12px 40px;}
  .mc-bar{flex-wrap:wrap;gap:12px;padding:16px 0 14px;}
  .mc-bar__filters,.mc-bar__right{gap:16px;}
  .mc-view{display:none;}
  .mc-grid,.mc[data-cols="4"] .mc-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:22px 8px;}
  .mc-card__title,.mc-card__price{font-size:12px;}
  .mc-card__fav{width:30px;height:30px;top:8px;right:8px;}
}
</style>
<script>
(function(){
  var root=document.querySelector('[data-mc]');if(!root)return;
  var K='morel_cols',F='morel_favs';
  function get(k){try{return localStorage.getItem(k);}catch(e){return null;}}
  function set(k,v){try{localStorage.setItem(k,v);}catch(e){}}
  function cols(n){root.setAttribute('data-cols',n);root.querySelectorAll('[data-mc-cols]').forEach(function(b){b.classList.toggle('is-active',b.getAttribute('data-mc-cols')==n);});}
  cols(get(K)||'3');
  root.querySelectorAll('[data-mc-cols]').forEach(function(b){b.addEventListener('click',function(){var n=b.getAttribute('data-mc-cols');cols(n);set(K,n);});});
  root.querySelectorAll('[data-mc-auto]').forEach(function(i){i.addEventListener('change',function(){i.form.submit();});});
  document.addEventListener('click',function(e){root.querySelectorAll('details.mc-dd[open]').forEach(function(d){if(!d.contains(e.target))d.removeAttribute('open');});});
  var favs=[];try{favs=JSON.parse(get(F)||'[]');}catch(e){}
  root.querySelectorAll('[data-fav]').forEach(function(b){
    var h=b.getAttribute('data-fav');b.setAttribute('aria-pressed',favs.indexOf(h)>-1?'true':'false');
    b.addEventListener('click',function(e){e.preventDefault();var i=favs.indexOf(h);if(i>-1)favs.splice(i,1);else favs.push(h);set(F,JSON.stringify(favs));b.setAttribute('aria-pressed',i>-1?'false':'true');});
  });
})();
</script>

{% schema %}
{
  "name": "Page collection",
  "settings": [
    { "type": "collection_list", "id": "related_collections", "label": "Collections associées", "limit": 12 }
  ]
}
{% endschema %}
