{%- comment -%} Section : une pochette Milo ou Capri offerte dès 120 € d'achat. {%- endcomment -%}
<section class="otr">
  <div class="otr__head">
    <p class="otr__kicker">{{ section.settings.kicker }}</p>
    <h2 class="otr__title">{{ section.settings.heading }}</h2>
    <p class="otr__sub">{{ section.settings.text }}</p>
  </div>
  <div class="otr__row">
    {%- assign shown = 0 -%}
    {%- assign gift_cols = 'la-milo,pochette-capri' | split: ',' -%}
    {%- for h in gift_cols -%}
      {%- for p in collections[h].products -%}
        {%- if p.available and shown < 4 -%}
          {%- if p.images.size > 1 -%}{%- assign im = p.images[1] -%}{%- else -%}{%- assign im = p.featured_image -%}{%- endif -%}
          <a class="otr__pic" href="{{ p.url }}"><img src="{{ im | image_url: width: 500 }}" alt="{{ p.title | escape }}" width="250" height="312" loading="lazy"><span>{{ p.title }}</span></a>
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  </div>
  <a class="otr__cta" href="{{ section.settings.button_url | default: '/collections/cabas' }}">{{ section.settings.button_label }}</a>
</section>
<style>
.otr{padding:64px 40px;background:#fff;color:#000;font-family:"Red Hat Text",var(--font-body),sans-serif;text-align:center;}
.otr__kicker{margin:0 0 14px;font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#b33a18;}
.otr__title{font-family:"Newsreader",Georgia,serif;font-weight:200;font-size:44px;line-height:1.05;letter-spacing:-.015em;margin:0 0 12px;text-transform:none;font-stretch:normal;}
.otr__sub{font-size:14px;color:#5c5650;margin:0 auto 36px;max-width:46ch;}
.otr__row{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;max-width:1100px;margin:0 auto 34px;}
.otr__pic{display:block;color:#000;text-decoration:none;font-size:12px;}
.otr__pic img{display:block;width:100%;height:auto;aspect-ratio:4/5;object-fit:cover;border-radius:12px;background:#f3efe9;margin-bottom:10px;}
.otr__cta{display:inline-flex;align-items:center;justify-content:center;height:50px;padding:0 34px;border-radius:18px;background:#b33a18;color:#fff;text-decoration:none;font-size:12px;letter-spacing:.06em;text-transform:uppercase;}
@media (max-width:767px){.otr{padding:44px 16px;}.otr__title{font-size:32px;}.otr__row{grid-template-columns:repeat(2,1fr);gap:10px;}}
</style>
{% schema %}
{
  "name": "Pochette offerte",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Accroche", "default": "Offert dès 120 € d'achat" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Une pochette Milo ou Capri offerte" },
    { "type": "text", "id": "text", "label": "Texte", "default": "Dès 120 € d'achat, choisissez votre pochette préférée : elle vous est offerte." },
    { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Découvrir les cabas" },
    { "type": "url", "id": "button_url", "label": "Lien du bouton" }
  ],
  "presets": [ { "name": "Pochette offerte" } ]
}
{% endschema %}
