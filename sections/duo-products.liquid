<div class="duo"><div class="duo__grid"> {%- assign coll = section.settings.collection -%} {%- assign idx = section.settings.image_index | minus: 1 -%} {%- if coll != blank -%} {%- for p in coll.products limit: section.settings.limit -%} {%- assign img = p.images[idx] | default: p.featured_image -%} <a href="{{ p.url }}" class="duo__card"> {%- if section.settings.badge != blank -%}<span class="duo__badge">{{ section.settings.badge }}</span>{%- endif -%} <img src="{{ img | image_url: width: 800 }}" alt="{{ p.title | escape }}" width="400" height="500" loading="lazy"><span class="duo__title">{{ p.title }}</span><span class="duo__price">{{ p.price | money }}</span></a> {%- endfor -%} {%- else -%} {%- for i in (1..4) -%}<div class="duo__card"><span class="placeholder-img"><span>Produit</span></span></div>{%- endfor -%} {%- endif -%} </div></div><style> .duo{background:#fff;} .duo__grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px 8px;padding:20px 18px;} .duo__card{position:relative;display:flex;flex-direction:column;color:#000;text-decoration:none;font-family:"Red Hat Text",var(--font-body),sans-serif;} .duo__card img,.duo__card .placeholder-img{display:block;width:100%;height:auto;aspect-ratio:4/5;object-fit:cover;} .duo__title,.duo__price{font-size:12px;line-height:1.2;letter-spacing:normal;} .duo__title{margin-top:14px;text-transform:uppercase;} .duo__badge{position:absolute;top:14px;left:14px;z-index:2;background:rgba(255,255,255,.9);color:#9a2a17;border-radius:999px;padding:6px 14px;font-size:13px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;} @media (max-width:767px){.duo__title,.duo__price{font-size:13px;line-height:1.6;}.duo__title{text-transform:none;}} </style> {% schema %} { "name": "Grille produits", "settings": [ { "type": "collection", "id": "collection", "label": "Collection" }, { "type": "range", "id": "limit", "label": "Nombre de produits", "min": 2, "max": 8, "step": 2, "default": 4 }, { "type": "range", "id": "image_index", "label": "Photo affichée (1 = principale, 2 = deuxième…)", "min": 1, "max": 4, "step": 1, "default": 2 }, { "type": "text", "id": "badge", "label": "Badge sur les photos" } ], "presets": [ { "name": "Grille produits" } ] } {% endschema %}