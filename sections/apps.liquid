<div class="morel-apps" style="padding:{{ section.settings.pad_top }}px var(--gutter, 20px) {{ section.settings.pad_bottom }}px;max-width:1400px;margin:0 auto;">
  {%- if section.settings.heading != blank -%}<h2 class="morel-apps__title">{{ section.settings.heading }}</h2>{%- endif -%}
  {%- for block in section.blocks -%}{% render block %}{%- endfor -%}
</div>
<style>.morel-apps__title{font-family:var(--font-heading);font-stretch:125%;font-weight:800;text-transform:uppercase;letter-spacing:var(--ls,0);font-size:clamp(24px,3vw,40px);line-height:1;text-align:center;margin:0 0 28px;}</style>
{% schema %}
{"name":"Applications","tag":"section","class":"section-apps","settings":[{"type":"text","id":"heading","label":"Titre"},{"type":"range","id":"pad_top","label":"Marge haut","min":0,"max":120,"step":4,"unit":"px","default":48},{"type":"range","id":"pad_bottom","label":"Marge bas","min":0,"max":120,"step":4,"unit":"px","default":48}],"blocks":[{"type":"@app"}],"presets":[{"name":"Applications"}]}
{% endschema %}