<section class="ig">
  <div class="ig__head">
    <h1 class="ig__title">{{ section.settings.heading | default: page.title }}</h1>
    {%- if section.settings.subheading != blank -%}<p class="ig__sub">{{ section.settings.subheading }}</p>{%- endif -%}
  </div>
  <div class="ig__grid">
    {%- for block in section.blocks -%}
      <figure class="ig__item" {{ block.shopify_attributes }}>
        {%- if block.settings.image -%}{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(max-width: 767px) 50vw, 25vw', alt: block.settings.caption }}{%- endif -%}
        {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption }}</figcaption>{%- endif -%}
      </figure>
    {%- endfor -%}
  </div>
</section>
<style>
.ig{padding:40px var(--gutter,20px) 64px;}
.ig__head{text-align:center;margin-bottom:28px;}
.ig__title{font-family:var(--font-heading);font-stretch:125%;font-weight:800;text-transform:uppercase;letter-spacing:var(--ls,0);font-size:clamp(28px,3.4vw,44px);line-height:1;margin:0;}
.ig__sub{font-family:var(--font-italic),"Newsreader",Georgia,serif;font-style:italic;color:#9a2a17;font-size:clamp(18px,1.8vw,22px);margin:10px 0 0;}
.ig__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;}
.ig__item{margin:0;}
.ig__item img{width:100%;height:auto;display:block;}
.ig__item figcaption{font-size:12px;text-transform:uppercase;letter-spacing:var(--ls,.4px);margin-top:8px;}
@media (max-width:767px){.ig{padding:28px 12px 48px;}.ig__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;}}
</style>
{% schema %}
{"name":"Grille d'images","settings":[{"type":"text","id":"heading","label":"Titre (sinon titre de la page)"},{"type":"text","id":"subheading","label":"Sous-titre"}],"blocks":[{"type":"image","name":"Image","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"caption","label":"Légende"}]}],"presets":[{"name":"Grille d'images"}]}
{% endschema %}