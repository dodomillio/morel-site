<section class="two-column-row">
  <div class="featured-products">
    {%- assign coll = section.settings.collection -%}
    {%- if section.settings.products.count > 4 -%}
    <div class="fp-pager" data-fp-pager>
      <div class="fp-pager__track" data-fp-track>
        {%- for product in section.settings.products limit: 12 -%}
          {%- assign m = forloop.index0 | modulo: 4 -%}
          {%- if m == 0 -%}<div class="featured-products__grid fp-pager__page">{%- endif -%}
          {% render 'product-card', product: product, second_image: section.settings.second_image %}
          {%- if m == 3 or forloop.last -%}</div>{%- endif -%}
        {%- endfor -%}
      </div>
      <div class="fp-pager__dots" data-fp-dots>
        {%- assign pages = section.settings.products.count | at_most: 12 | plus: 3 | divided_by: 4 -%}
        {%- for i in (1..pages) -%}<button type="button" class="fp-pager__dot{% if forloop.first %} is-active{% endif %}" aria-label="Page {{ i }}" data-fp-dot="{{ forloop.index0 }}"></button>{%- endfor -%}
      </div>
    </div>
    <style>
      .featured-products:has(.fp-pager){min-width:0;}.fp-pager{min-width:0;width:100%;max-width:100%;contain:inline-size;}
      .fp-pager__track{width:100%;display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;-webkit-overflow-scrolling:touch;}
      .fp-pager__track::-webkit-scrollbar{display:none;}
      .fp-pager__page{flex:0 0 100%;width:100%;min-width:0;display:grid !important;grid-template-columns:repeat(2,minmax(0,1fr)) !important;scroll-snap-align:start;box-sizing:border-box;}
      .fp-pager__dots{display:flex;justify-content:center;gap:8px;padding:14px 0 6px;}
      .fp-pager__dot{width:7px;height:7px;border-radius:50%;border:1px solid #111;background:transparent;padding:0;cursor:pointer;}
      .fp-pager__dot.is-active{background:#111;}
    </style>
    <script>
      (function(){document.querySelectorAll('[data-fp-pager]').forEach(function(p){if(p.__fp)return;p.__fp=1;var t=p.querySelector('[data-fp-track]'),d=p.querySelectorAll('[data-fp-dot]');
        function act(){var i=Math.round(t.scrollLeft/t.clientWidth);d.forEach(function(x,j){x.classList.toggle('is-active',j===i);});}
        t.addEventListener('scroll',function(){window.requestAnimationFrame(act);},{passive:true});
        d.forEach(function(x){x.addEventListener('click',function(){t.scrollTo({left:t.clientWidth*parseInt(x.getAttribute('data-fp-dot'),10),behavior:'smooth'});});});});})();
    </script>
    {%- else -%}
    <div class="featured-products__grid">
      {%- assign coll = section.settings.collection -%}
      {%- if section.settings.products != blank -%}
        {%- for product in section.settings.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product, second_image: section.settings.second_image %}
        {%- endfor -%}
      {%- elsif coll != blank -%}
        {%- comment -%} Produits en stock d'abord, épuisés ensuite seulement s'il reste de la place {%- endcomment -%}
        {%- assign shown = 0 -%}
        {%- for product in coll.products -%}
          {%- if product.available and shown < section.settings.products_to_show -%}
            {% render 'product-card', product: product, second_image: section.settings.second_image %}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
        {%- for product in coll.products -%}
          {%- unless product.available -%}{%- if shown < section.settings.products_to_show -%}
            {% render 'product-card', product: product, second_image: section.settings.second_image %}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}{%- endunless -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.products_to_show) -%}
          <a class="product-card" href="#">
            <span class="placeholder-img placeholder-img--product"><span>Produit</span></span>
            <button class="product-card__wishlist" type="button" aria-label="Ajouter aux favoris">&#9825;</button>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
    {%- endif -%}
    <div class="featured-products__bottom">
      <h2 class="featured-products__title">{{ section.settings.heading }}</h2>
      <a class="featured-products__cta" href="{{ coll.url | default: '#' }}">{{ section.settings.button_label }}</a>
    </div>
  </div>

  {%- for block in section.blocks -%}
    <a class="banner" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>
      {%- if block.settings.image -%}
        <img class="banner__image" src="{{ block.settings.image | image_url: width: 1600 }}" width="800" alt="" loading="lazy">
      {%- else -%}
        <span class="placeholder-img placeholder-img--tall"><span>Bannière</span></span>
      {%- endif -%}
      <span class="banner__overlay">
        {%- if block.settings.heading != blank -%}<span class="banner__title">{{ block.settings.heading }}</span>{%- endif -%}
        {%- if block.settings.subheading != blank -%}<span class="banner__subtitle">{{ block.settings.subheading }}</span>{%- endif -%}
        {%- if block.settings.button_label != blank -%}<span class="banner__cta">{{ block.settings.button_label }}</span>{%- endif -%}
      </span>
    </a>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Produits + bannière",
  "max_blocks": 1,
  "settings": [
    { "type": "checkbox", "id": "second_image", "label": "Afficher la 2e photo des produits", "default": true },
    { "type": "product_list", "id": "products", "label": "Produits choisis (optionnel, remplace la collection)", "limit": 12 },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Nombre de produits", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Les indispensables" },
    { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Découvrir" }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Bannière",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Titre", "default": "Le prêt-à-porter" },
        { "type": "text", "id": "subheading", "label": "Sous-titre" },
        { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Découvrir" },
        { "type": "url", "id": "url", "label": "Lien" }
      ]
    }
  ],
  "presets": [
    { "name": "Produits + bannière", "blocks": [{ "type": "banner" }] }
  ]
}
{% endschema %}
