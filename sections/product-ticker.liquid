<section class="two-column-row">
  <a class="banner" href="{{ section.settings.banner_url }}">
    {%- if section.settings.banner_image -%}
      <img class="banner__image" src="{{ section.settings.banner_image | image_url: width: 1600 }}" width="800" alt="" loading="lazy">
    {%- else -%}
      <span class="placeholder-img placeholder-img--tall"><span>Bannière</span></span>
    {%- endif -%}
    <span class="banner__overlay">
      {%- if section.settings.banner_heading != blank -%}<span class="banner__title">{{ section.settings.banner_heading }}</span>{%- endif -%}
      {%- if section.settings.banner_subheading != blank -%}<span class="banner__subtitle">{{ section.settings.banner_subheading }}</span>{%- endif -%}
      <span class="banner__cta">Découvrir</span>
    </span>
  </a>

  <div class="pt-grid">
    {%- if section.settings.grid_products.count > 0 -%}
      {%- for product in section.settings.grid_products -%}{% render 'product-card', product: product %}{%- endfor -%}
    {%- else -%}
      {%- for product in collections['le-solen'].products limit: 2 -%}{% render 'product-card', product: product %}{%- endfor -%}
      {%- for product in collections['le-nomad'].products limit: 2 -%}{% render 'product-card', product: product %}{%- endfor -%}
    {%- endif -%}
  </div>
  <style>
    .pt-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px 12px;padding:24px var(--gutter,20px);grid-column:1/-1;flex:0 0 100%;width:100%;box-sizing:border-box;}
    .pt-grid .product-card{min-width:0;}
    @media (max-width:767px){.pt-grid{grid-template-columns:repeat(2,minmax(0,1fr));padding:20px 16px;}}
  </style>

  <div class="product-ticker">
    <div class="product-ticker__inner">
      <div class="product-ticker__viewport">
        <div class="product-ticker__track" data-ticker-track>
          {%- assign coll = section.settings.collection -%}
          {%- for i in (1..2) -%}
            <div class="product-ticker__group"{% if i == 2 %} aria-hidden="true"{% endif %}>
              {%- if coll != blank -%}
                {%- for product in coll.products limit: 8 -%}
                  {%- if product.featured_image -%}
                    <img class="product-ticker__image" src="{{ product.featured_image | image_url: width: 400 }}" width="140" alt="" loading="lazy">
                  {%- else -%}
                    <span class="placeholder-img placeholder-img--product"><span>Produit</span></span>
                  {%- endif -%}
                {%- endfor -%}
              {%- else -%}
                {%- for j in (1..6) -%}
                  <span class="placeholder-img placeholder-img--product"><span>Produit</span></span>
                {%- endfor -%}
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
      <div class="product-ticker__label">
        <h2>{{ section.settings.heading }}</h2>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bannière + produits",
  "settings": [
    { "type": "image_picker", "id": "banner_image", "label": "Image de la bannière" },
    { "type": "text", "id": "banner_heading", "label": "Titre de la bannière", "default": "Édition limitée" },
    { "type": "text", "id": "banner_subheading", "label": "Sous-titre de la bannière" },
    { "type": "url", "id": "banner_url", "label": "Lien de la bannière" },
    { "type": "collection", "id": "collection", "label": "Collection du bandeau défilant" },
    { "type": "text", "id": "heading", "label": "Titre du bandeau", "default": "Réassort" },
    { "type": "product_list", "id": "grid_products", "label": "Grille de produits (sinon 2 Solen + 2 Nomad)", "limit": 8 }
  ],
  "presets": [{ "name": "Bannière + produits" }]
}
{% endschema %}
