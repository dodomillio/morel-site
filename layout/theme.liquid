<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ page_title }}{% unless page_title contains shop.name %} &middot; {{ shop.name }}{% endunless %}</title>
{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
<link rel="canonical" href="{{ canonical_url }}">
<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">
{{ content_for_header }}
{{ 'theme.css' | asset_url | stylesheet_tag }}
<style>
  :root {
    --footer-background: {{ settings.color_footer_bg }};
    --footer-foreground: {{ settings.color_footer_fg }};
    --main-menu-background: {{ settings.color_header_bg }};
    --main-menu-foreground: {{ settings.color_header_fg }};
    --color-accent: {{ settings.color_accent }};
  }
</style>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@125,700;125,800&family=Baskervville:ital@1&family=Figtree:wght@300;400;500;600&display=swap"><style id="morel-reference">:root{--font-body: "Figtree","Helvetica Neue",Arial,sans-serif;--font-heading: "Archivo","Helvetica Neue",Arial,sans-serif;--font-italic: "Baskervville",Georgia,serif;--ls: 0.4px;--gutter: 36px;}body{font-family: var(--font-body);letter-spacing: var(--ls);}h1,h2,h3,h4,h5,h6{font-family: var(--font-heading);font-stretch: 125%;font-weight: 800;letter-spacing: var(--ls);}.banner-message{font-size: 11px;letter-spacing: var(--ls);}.main-menu__link,.static-menu__link{font-size: 11px;font-weight: 400;letter-spacing: var(--ls);text-transform: uppercase;}@media (min-width: 900px) and (max-width: 1180px){.main-menu__link{font-size: 11px;}}.header__inner{padding: 0 var(--gutter);}main,#MainContent{gap: 0 !important;}:is(html, #_) .hero-editorial .hero-editorial__panel img,:is(html, #_) .hero-editorial .hero-editorial__panel .placeholder-img{height: 100% !important;min-height: 0 !important;}:is(html, #_) .hero-editorial .hero-editorial__logo-vertical,:is(html, #_) .hero-editorial .hero-editorial__logo-horizontal{font-family: var(--font-heading) !important;font-stretch: 125%;font-weight: 800 !important;letter-spacing: var(--ls) !important;}:is(html, #_) .hero-editorial .hero-editorial__overlay{align-items: center !important;text-align: center !important;gap: 0 !important;padding: 32px 24px !important;background: none !important;}:is(html, #_) .hero-editorial .hero-editorial__title{font-family: var(--font-heading) !important;font-stretch: 125%;font-weight: 800 !important;font-size: 17px !important;line-height: 1.15 !important;letter-spacing: var(--ls) !important;text-transform: uppercase !important;max-width: none !important;}:is(html, #_) .hero-editorial .hero-editorial__title br{display: none;}:is(html, #_) .hero-editorial .hero-editorial__subtitle{font-family: var(--font-italic) !important;font-style: italic !important;font-size: 20px !important;letter-spacing: var(--ls) !important;opacity: 1 !important;}:is(html, #_) .hero-editorial .hero-editorial__cta{align-self: center !important;margin-top: 12px !important;padding: 12px !important;background: #000 !important;color: #fff !important;font-family: var(--font-body) !important;font-weight: 400 !important;font-size: 12px !important;letter-spacing: var(--ls) !important;text-transform: uppercase !important;}.two-column-row{gap: 0;}.banner__overlay{padding: 32px 24px;gap: 0;align-items: center;text-align: center;background: none;}.banner__title{font-family: var(--font-heading);font-stretch: 125%;font-weight: 800;font-size: 17px;line-height: 1.15;letter-spacing: var(--ls);text-transform: uppercase;}.banner__subtitle{font-family: var(--font-italic);font-style: italic;font-size: 20px;opacity: 1;letter-spacing: var(--ls);}.banner__cta,.featured-products__cta{align-self: center;display: inline-block;margin-top: 12px;padding: 12px;border: 0;border-radius: 0;background: #000;color: #fff;font-size: 12px;font-weight: 400;letter-spacing: var(--ls);text-transform: uppercase;}.banner__store-info{background: none;padding: 40px var(--gutter);}.banner__address{font-family: var(--font-italic);font-style: italic;font-size: 20px;}.featured-products__grid{gap: 4px;}.product-card__title,.product-card__price{display: block;font-size: 11px;line-height: 13.2px;letter-spacing: var(--ls);padding: 4px 16px 0;}.featured-products__bottom{flex-direction: column;align-items: flex-start;justify-content: flex-start;gap: 0;padding: 36px var(--gutter);border-bottom: 0;}.featured-products__title{font-family: var(--font-heading);font-stretch: 125%;font-weight: 800;font-size: 17px;text-transform: uppercase;letter-spacing: var(--ls);}.featured-products__cta{align-self: flex-start;}.product-ticker__label h2{font-family: var(--font-heading);font-stretch: 125%;font-weight: 800;font-size: clamp(28px,4vw,44px);line-height: 1;letter-spacing: var(--ls);text-transform: uppercase;}.site-footer{margin-top: 0;}.site-footer__grid{max-width: none;padding: 40px var(--gutter) 20px;gap: 32px;}.footer__title{font-family: var(--font-heading);font-stretch: 125%;font-weight: 800;font-size: 12px;letter-spacing: var(--ls);text-transform: uppercase;margin-bottom: 20px;}.footer__list{gap: 4px;}.footer__list a{font-size: 13px;line-height: 18.2px;opacity: 1;}.footer__newsletter-incentive{font-size: 12px;font-weight: 300;text-transform: uppercase;letter-spacing: var(--ls);margin-bottom: 10px;}.footer__newsletter-form{gap: 0;border-bottom: 1px solid currentColor;}.footer__newsletter-form input{border: 0;padding: 10px 0;font-size: 13px;}.footer__newsletter-form button{background: none;color: inherit;border: 0;padding: 0 10px;font-family: var(--font-heading);font-stretch: 125%;font-weight: 800;font-size: 12px;}.footer__newsletter-legal{font-size: 12px;margin-top: 16px;}.site-footer__bottom{border-top: 0;padding: 120px var(--gutter) 20px;text-align: left;}.site-footer__bottom p{font-size: 8px;text-transform: uppercase;}@media (max-width: 767px){:root{--gutter: 20px;}body .hero-editorial__title{font-size: 17px;}.site-footer__bottom{padding-top: 48px;}}</style><style id="morel-responsive">@media (min-width:1440px){.banner__title,.featured-products__title{font-size:26px;}.banner__subtitle,.banner__address{font-size:37px;}:is(html, #_) .hero-editorial .hero-editorial__title{font-size:26px !important;}:is(html, #_) .hero-editorial .hero-editorial__subtitle{font-size:37px !important;}}@media (max-width:1023px){.banner__cta,.featured-products__cta{font-size:10px;}:is(html, #_) .hero-editorial .hero-editorial__cta{font-size:10px !important;}.product-ticker__label h2{font-size:32px;}}@media (min-width:1024px){.product-ticker__label h2{font-size:44px;}}</style><style id="morel-products-grid">.two-colu