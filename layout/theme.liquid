orm:uppercase;}}</style><style id="morel-swap">main:has(> [id$="__hero-editorial-1"] + [id$="__featured-1"]){display:grid !important;grid-template-columns:minmax(0,1fr) minmax(0,1fr);position:relative;align-items:stretch;}main > .shopify-section{grid-column:1/-1;order:10;min-width:0;}main > [id$="__hero-editorial-1"],main > [id$="__featured-1"],main > [id$="__featured-1"] > .two-column-row{display:contents !important;}:is(#_, main) [id$="__hero-editorial-1"] .hero-editorial{display:contents !important;}main [id$="__hero-editorial-1"] .hero-editorial__logo + .hero-editorial__panel{order:1;grid-column:auto;}main [id$="__featured-1"] .featured-products{order:2;grid-column:auto;}main [id$="__hero-editorial-1"] .hero-editorial__panel + .hero-editorial__panel{order:3;grid-column:auto;}main [id$="__featured-1"] > .two-column-row > .banner{order:5;grid-column:auto;}main > [id$="__featured-2"],main > [id$="__featured-2"] > .two-column-row{display:contents !important;}main [id$="__featured-2"] .featured-products{order:4;grid-column:auto;}main [id$="__featured-2"] > .two-column-row > .banner{order:6;grid-column:auto;}@media (max-width:767px){main:has(> [id$="__hero-editorial-1"] + [id$="__featured-1"]){grid-template-columns:minmax(0,1fr);}}.morel-apps{min-width:0;overflow:hidden;}@media (max-width:767px){main > [id$="__ticker-1"]{order:6 !important;}main [id$="__featured-2"] > .two-column-row > .banner{order:7 !important;}}@media (min-width:768px){main [id$="__featured-2"] .featured-products{order:3 !important;}main [id$="__hero-editorial-1"] .hero-editorial__panel + .hero-editorial__panel{order:4 !important;}}</style><style id="morel-duo">main > [id*="duo_products"],main > [id*="duo-products"]{display:contents !important;}main [id*="duo_products"] .duo,main [id*="duo-products"] .duo{order:4;grid-column:auto;}main:has([id*="duo_products"],[id*="duo-products"]) [id$="__featured-1"] > .two-column-row > .banner{display:none !important;}</style><style id="morel-duo-desktop">@media (min-width:768px){main [id*="duo_products"] .duo{order:3 !important;}main [id$="__hero-editorial-1"] .hero-editorial__panel + .hero-editorial__panel{order:4 !important;}}</style><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,200;6..72,300;6..72,400&display=swap"><style id="morel-promo-title">main [id$="__featured-1"] .featured-products::before{content:"Une pochette offerte";order:-2;display:block;text-align:center;padding:32px 20px 0;font-family:"Newsreader",Georgia,serif;font-stretch:normal;font-weight:200;font-size:clamp(32px,3.6vw,48px);line-height:1.05;letter-spacing:-.01em;text-transform:none;color:#000;}main [id$="__featured-1"] .featured-products::after{content:"dès 120 € d'achat";order:-1;display:block;text-align:center;padding:6px 20px 0;font-family:var(--font-italic);font-style:italic;font-size:clamp(18px,1.8vw,22px);color:#9a2a17;}</style>
<style id="morel-ticker">.product-ticker__label{background:transparent !important;padding:0 !important;box-shadow:none !important;}.product-ticker__label h2{font-size:clamp(22px,2.6vw,36px) !important;white-space:nowrap !important;line-height:1 !important;}#tt-carousel-title{font-family:"Newsreader",Georgia,serif !important;font-stretch:normal !important;font-weight:200 !important;text-transform:none !important;letter-spacing:-.01em !important;font-size:clamp(32px,3.6vw,48px) !important;line-height:1.05 !important;color:#000 !important;}#tt-carousel-desc,#tt-carousel-desc *{font-family:var(--font-italic),"Newsreader",Georgia,serif !important;font-style:italic !important;font-weight:400 !important;font-size:clamp(18px,1.8vw,22px) !important;text-transform:none !important;letter-spacing:0 !important;color:#9a2a17 !important;}#tt-carousel-desc{margin-top:6px !important;}div:has(> .tt-card-review) > div:first-child:not(.resource-list):not(.tt-card-review){display:none !important;}</style>
</head>
<body>
  <div class="overlay" data-overlay></div>

  {% section 'header' %}
  {% render 'mobile-menu' %}
  {% render 'cart-drawer' %}
  {% render 'search-drawer' %}

  <main>
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {{ 'theme.js' | asset_url | script_tag }}
</body>
</html>
