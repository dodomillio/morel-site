{%- comment -%} Expects: product {%- endcomment -%}
<a class="product-card" href="{{ product.url }}">
  {%- if product.featured_image -%}
    <img class="product-card__image" src="{{ product.featured_image | image_url: width: 800 }}" width="400" alt="{{ product.title | escape }}" loading="lazy">
  {%- else -%}
    <span class="placeholder-img placeholder-img--product"><span>Produit</span></span>
  {%- endif -%}
  <button class="product-card__wishlist" type="button" aria-label="Ajouter aux favoris" onclick="event.preventDefault()">&#9825;</button>
  <span class="product-card__title">{{ product.title }}</span>
  <span class="product-card__price">{{ product.price | money }}</span>
</a>
