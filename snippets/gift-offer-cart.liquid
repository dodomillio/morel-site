{%- comment -%} Message pochette offerte dès 120 € dans le panier (tiroir et page). Les boutons utilisent data-cd-add du panier. {%- endcomment -%}
{%- liquid
  assign has_gift = false
  for item in cart.items
    if item.final_line_price == 0 and item.original_line_price > 0
      assign has_gift = true
    endif
  endfor
  assign left = 12000 | minus: cart.total_price
  assign pct = cart.total_price | times: 100 | divided_by: 12000
  if pct > 100
    assign pct = 100
  endif
  assign gift_cols = 'la-milo,pochette-capri' | split: ','
-%}
<div class="cdg{% if left <= 0 %} is-ok{% endif %}">
  {%- if has_gift -%}
    <p class="cdg__txt">Votre pochette offerte est dans votre panier.</p>
  {%- elsif left > 0 -%}
    <p class="cdg__txt">Plus que {{ left | money }} pour recevoir une pochette Milo ou Capri offerte.</p>
    <div class="cdg__bar"><span style="width:{{ pct }}%"></span></div>
  {%- else -%}
    <p class="cdg__txt">Vous y avez droit : choisissez votre pochette offerte.</p>
    <div class="cdg__list">
      {%- for h in gift_cols -%}
        {%- for p in collections[h].products -%}
          {%- if p.available -%}
            {%- assign im = p.featured_image -%}{%- for m in p.images -%}{%- if m.width == m.height -%}{%- assign im = m -%}{%- break -%}{%- endif -%}{%- endfor -%}
            <div class="cdg__card">
              <img src="{{ im | image_url: width: 160 }}" alt="{{ p.title | escape }}" width="64" height="80" loading="lazy">
              <span class="cdg__name">{{ p.title }}</span>
              <button type="button" class="cdg__add" data-cd-add="{{ p.first_available_variant.id }}">Choisir</button>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
<style>
.cdg{margin:0 0 14px;padding:12px 14px;border:1px solid #e6ddd3;border-radius:12px;background:#faf7f3;font-family:"Red Hat Text",var(--font-body),sans-serif;}
.cdg.is-ok{border-color:#b33a18;}
.cdg__txt{margin:0;font-size:12px;line-height:1.45;color:#000;}
.cdg.is-ok .cdg__txt{color:#b33a18;font-weight:700;}
.cdg__bar{height:5px;margin-top:9px;border-radius:5px;background:#ece5dd;overflow:hidden;}
.cdg__bar span{display:block;height:100%;background:#b33a18;border-radius:5px;}
.cdg__list{display:flex;gap:8px;overflow-x:auto;margin-top:10px;padding-bottom:2px;scrollbar-width:none;contain:inline-size;}
.cdg__list::-webkit-scrollbar{display:none;}
.cdg__card{flex:0 0 92px;display:flex;flex-direction:column;gap:5px;}
.cdg__card img{display:block;width:92px;height:115px;object-fit:cover;border-radius:8px;background:#f3efe9;}
.cdg__name{font-size:10px;line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.cdg__add{height:28px;border:0;border-radius:8px;background:#b33a18;color:#fff;font-size:10px;letter-spacing:.06em;text-transform:uppercase;cursor:pointer;}
</style>
