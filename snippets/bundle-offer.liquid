{%- comment -%} Offre lot : 2 cabas achetés = 1 sac offert / 2 pochettes achetées = 1 pochette offerte. La remise est appliquée par les réductions automatiques Shopify. {%- endcomment -%}
{%- liquid
  assign offer = ''
  for c in product.collections
    if c.handle == 'cabas'
      assign offer = 'cabas'
    endif
  endfor
  if offer == ''
    for c in product.collections
      if c.handle == 'nos-pochettes'
        assign offer = 'pochette'
      endif
    endfor
  endif
  assign bv = product.selected_or_first_available_variant
  assign unit = bv.price
-%}
{%- if offer != '' -%}
<div class="mp-bundle" data-bundle>
  <span class="mp-bundle__tag">Offre lot</span>
  {%- if offer == 'cabas' -%}
    <p class="mp-bundle__title">2 cabas achetés = 1 sac offert</p>
    <p class="mp-bundle__text">Ajoutez un 3e sac (cabas ou pochette) : le moins cher vous est offert, automatiquement au panier.</p>
  {%- else -%}
    <p class="mp-bundle__title">2 pochettes achetées = la 3e offerte</p>
    <p class="mp-bundle__text">Ajoutez 3 pochettes au panier : la moins chère vous est offerte, automatiquement.</p>
  {%- endif -%}
  {%- if bv.available -%}
    <button type="button" class="mp-bundle__btn" data-bundle-add>Prendre le lot de 3 · {{ unit | times: 2 | money }} <s>{{ unit | times: 3 | money }}</s></button>
    <p class="mp-bundle__note">Envie de mixer les couleurs ? Ajoutez vos modèles un par un, la remise s'applique toute seule.</p>
  {%- endif -%}
</div>
<style>
.mp-bundle{margin:20px 0 0;padding:18px 18px 16px;border:1px solid #e5d9cc;border-radius:18px;background:#faf6f1;text-align:center;}
.mp-bundle__tag{display:inline-block;font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:#b33a18;border:1px solid #b33a18;border-radius:20px;padding:3px 10px;margin-bottom:10px;}
.mp-bundle__title{font-family:var(--mp-serif,Georgia,serif);font-weight:300;font-size:22px;line-height:1.2;margin:0 0 6px;color:#000;}
.mp-bundle__text{font-size:13px;line-height:1.5;color:#444;margin:0 0 14px;}
.mp-bundle__btn{width:100%;height:48px;border:1px solid #000;border-radius:18px;background:#fff;color:#000;font-family:var(--mp-sans,inherit);font-size:12px;text-transform:uppercase;letter-spacing:.04em;cursor:pointer;transition:background .2s,color .2s;}
.mp-bundle__btn:hover{background:#000;color:#fff;}
.mp-bundle__btn s{opacity:.5;margin-left:6px;}
.mp-bundle__note{font-size:11px;line-height:1.5;color:#777;margin:10px 0 0;}
</style>
<script>
(function(){
  var box = document.currentScript.parentNode.querySelector('[data-bundle]');
  if (!box) return;
  var btn = box.querySelector('[data-bundle-add]');
  if (!btn) return;
  btn.addEventListener('click', function(){
    var form = document.querySelector('.mp__form');
    if (!form) return;
    var qty = form.querySelector('input[name="quantity"]');
    if (qty) qty.value = 3;
    var add = form.querySelector('[name="add"]');
    if (form.requestSubmit) { form.requestSubmit(add || undefined); } else { form.submit(); }
  });
})();
</script>
{%- endif -%}
