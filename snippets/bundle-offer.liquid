{%- comment -%} Offre : une pochette Milo ou Capri offerte dès 120 € d'achat. La remise est appliquée par la réduction automatique Shopify. Appel avec teaser: true pour la ligne sous le prix. {%- endcomment -%}
{%- assign gift_cols = 'la-milo,pochette-capri' | split: ',' -%}
{%- if teaser -%}
<a href="#pochette-offerte" class="trio-teaser" data-gift-teaser>Une pochette offerte dès 120 € d'achat</a>
<style>
.trio-teaser{display:block;margin:-8px 0 24px;text-align:center;font-family:var(--mp-serif,"Newsreader",Georgia,serif);font-weight:400;font-size:21px;line-height:1.2;letter-spacing:0;text-transform:none;color:#b33a18;text-decoration:none;}
.trio-teaser:hover{text-decoration:underline;text-underline-offset:4px;}
</style>
<script>
(function(){var t=document.querySelector('[data-gift-teaser]');if(!t)return;t.addEventListener('click',function(e){var el=document.getElementById('pochette-offerte');if(!el)return;e.preventDefault();el.scrollIntoView({behavior:'smooth',block:'start'});});})();
</script>
{%- else -%}
<div class="gft" id="pochette-offerte" data-gift>
  <div class="gft__head">
    <h3 class="gft__title">Une pochette offerte</h3>
    <p class="gft__sub">Dès 120 € d'achat, choisissez votre pochette Milo ou Capri. Elle passe à 0 € dans votre panier.</p>
  </div>
  <div class="gft__bar"><span data-gift-fill></span></div>
  <p class="gft__state" data-gift-state>&nbsp;</p>
  <div class="gft__pick">
    {%- for h in gift_cols -%}
      {%- for p in collections[h].products -%}
        {%- if p.available -%}
          {%- assign v = p.first_available_variant -%}
          {%- assign im = p.featured_image -%}
          {%- for m in p.images -%}{%- if m.width == m.height -%}{%- assign im = m -%}{%- break -%}{%- endif -%}{%- endfor -%}
          <button type="button" class="gft__item" data-gift-id="{{ v.id }}" data-gift-pid="{{ p.id }}">
            <span class="gft__thumb"><img src="{{ im | image_url: width: 400 }}" alt="{{ p.title | escape }}" width="200" height="250" loading="lazy"></span>
            <span class="gft__name">{{ p.title }}</span>
            <span class="gft__p"><s>{{ v.price | money }}</s><em>offerte</em></span>
            <span class="gft__cta">Choisir</span>
          </button>
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  </div>
  <p class="gft__hint" data-gift-hint></p>
</div>
<style>
.mp__grid>*{min-width:0;}
.gft{min-width:0;max-width:100%;margin:32px 0 0;padding:28px 0 0;border-top:1px solid #e5e5e5;color:#000;font-family:var(--mp-sans,inherit);scroll-margin-top:90px;}
.gft__title{font-family:var(--mp-serif,"Newsreader",Georgia,serif);font-weight:300;font-size:26px;line-height:1.15;margin:0 0 8px;text-transform:none;letter-spacing:0;font-stretch:normal;}
.gft__sub{font-size:13px;line-height:1.55;color:#555;margin:0 0 22px;}
.gft__bar{height:1px;background:#e5e5e5;position:relative;}
.gft__bar span{position:absolute;left:0;top:-1px;height:3px;width:0;background:#000;transition:width .6s ease;}
.gft__state{font-size:12px;letter-spacing:.02em;margin:10px 0 22px;min-height:16px;color:#444;}
.gft.is-ok .gft__state{color:#000;}
.gft__pick{display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;contain:inline-size;padding-bottom:4px;}
.gft__pick::-webkit-scrollbar{display:none;}
.gft__item{flex:0 0 calc((100% - 24px) / 3);width:calc((100% - 24px) / 3);min-width:0;scroll-snap-align:start;background:none;border:0;padding:0;cursor:pointer;text-align:left;color:#000;font:inherit;}
.gft__thumb{display:block;margin-bottom:10px;background:#f2f2f2;overflow:hidden;}
.gft__thumb img{display:block;width:100%;height:auto;aspect-ratio:4/5;object-fit:cover;transition:opacity .25s;}
.gft__item:hover .gft__thumb img{opacity:.85;}
.gft__name{display:block;font-size:11px;line-height:1.4;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.gft__p{display:flex;gap:6px;align-items:baseline;font-size:11px;margin-top:2px;}
.gft__p s{color:#999;}
.gft__p em{font-family:var(--mp-serif,"Newsreader",Georgia,serif);font-style:italic;font-size:14px;color:#b33a18;}
.gft__cta{display:inline-block;margin-top:8px;font-size:10px;letter-spacing:.08em;text-transform:uppercase;border-bottom:1px solid currentColor;padding-bottom:1px;}
.gft__item[disabled]{cursor:wait;opacity:.6;}
.gft__hint{font-size:12px;color:#555;margin:14px 0 0;min-height:16px;}
@media (max-width:767px){.gft__item{flex-basis:40%;width:40%;}.gft__title{font-size:24px;}}
</style>
<script>
(function(){
  var box = document.querySelector('[data-gift]');
  if (!box || box.dataset.ready) return;
  box.dataset.ready = '1';
  var MIN = 12000;
  var fill = box.querySelector('[data-gift-fill]');
  var state = box.querySelector('[data-gift-state]');
  var hint = box.querySelector('[data-gift-hint]');
  var pids = [].map.call(box.querySelectorAll('[data-gift-pid]'), function(b){ return +b.dataset.giftPid; });
  var info = { left: MIN, has: false };
  function money(c){ return '€' + (c/100).toFixed(2).replace('.', ','); }
  function refresh(){
    return fetch('/cart.js', { credentials: 'same-origin' }).then(function(r){ return r.json(); }).then(function(c){
      var has = c.items.some(function(i){ return pids.indexOf(i.product_id) > -1 && i.final_line_price === 0; });
      var left = Math.max(0, MIN - c.total_price);
      info = { left: left, has: has };
      fill.style.width = Math.min(100, c.total_price / MIN * 100) + '%';
      box.classList.toggle('is-ok', left === 0);
      if (has) state.textContent = 'Votre pochette offerte est dans votre panier.';
      else if (left > 0) state.textContent = c.total_price > 0 ? 'Plus que ' + money(left) + ' pour recevoir votre pochette offerte.' : 'Ajoutez 120 € d\'articles et recevez une pochette offerte.';
      else state.textContent = 'Vous y avez droit : choisissez votre pochette offerte ci-dessous.';
    }).catch(function(){});
  }
  box.querySelectorAll('[data-gift-id]').forEach(function(b){
    b.addEventListener('click', function(){
      if (info.has) { hint.textContent = 'Une seule pochette offerte par commande.'; return; }
      if (info.left > 0) { hint.textContent = 'Ajoutez encore ' + money(info.left) + ' d\'articles à votre panier pour en profiter.'; return; }
      b.disabled = true; hint.textContent = 'Ajout de votre pochette…';
      fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ items: [{ id: +b.dataset.giftId, quantity: 1 }] }) })
        .then(function(r){ if (!r.ok) throw r; return r.json(); })
        .then(function(){ hint.textContent = 'Votre pochette offerte a été ajoutée.'; refresh(); if (window.cdOpen) { try { window.cdOpen(); return; } catch(e){} } window.location.href = '/cart'; })
        .catch(function(){ hint.textContent = 'Cette pochette n\'est plus disponible, choisissez-en une autre.'; })
        .then(function(){ b.disabled = false; });
    });
  });
  if (window.fetch && !window.__giftFetch) {
    window.__giftFetch = true;
    var f = window.fetch;
    window.fetch = function(u){ var p = f.apply(this, arguments); try { var s = String(u && u.url || u); if (/\/cart\/(add|change|update|clear)/.test(s)) p.then(function(){ setTimeout(refresh, 400); }); } catch(e){} return p; };
  }
  document.addEventListener('visibilitychange', function(){ if (!document.hidden) refresh(); });
  refresh();
})();
</script>
{%- endif -%}
